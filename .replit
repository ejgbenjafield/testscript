modules = ["nodejs-20", "web"]

# The Run button: install packages, update the database, then start the API
# (port 8080) and the website with live reload (port 5000, shown in the preview).
run = "npm run replit:dev"

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm install --include=dev && npm run build"]
# One server on port 5000 serves both the website and the API.
run = ["sh", "-c", "PORT=5000 npm start"]

[[ports]]
localPort = 5000
externalPort = 80
