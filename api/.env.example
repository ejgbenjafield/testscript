# Copy to api/.env for local development outside Replit.
# On Replit, set these in the Secrets tool instead (DATABASE_URL is added for you
# when you create the PostgreSQL database).

DATABASE_URL=postgres://testscript:testscript@localhost:5432/testscript
PORT=8080

# Any long random string. Signs dev-login tokens and file download links.
APP_SIGNING_SECRET=change-me-to-a-long-random-string

# Public address of the site, used in invite links. Optional: worked out from the request if blank.
APP_URL=

# dev = sign in with any email (no password). auth0 = real logins.
AUTH_MODE=dev
# Dev login is refused in a published app unless you set this to true.
ALLOW_DEV_LOGIN=false

AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=https://api.testscript.app

# replit = Replit Object Storage, local = files in api/data/uploads.
# Chosen automatically (replit when running on Replit) if blank.
STORAGE_DRIVER=

# Optional: send invite emails.
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@testscript.app
